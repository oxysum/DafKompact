  "grammar": [
    {
      "id": "g1",
      "titleDe": "Adjektive im Nominativ und Akkusativ nach unbestimmtem Artikel",
      "titleEn": "Adjective endings after ein/eine",
      "explanationEn": "After ein/eine/kein and possessives, adjectives take strong-ish endings: ein leckerer Salat (Nom. masc.), einen leckeren Salat (Akk. masc.), eine kleine Party (Nom./Akk. fem.), ein gutes Bier (Nom./Akk. neut.).",
      "patterns": [
        "ein + -er (Nom. mask.)",
        "einen + -en (Akk. mask.)",
        "eine + -e",
        "ein + -es (neut.)"
      ],
      "examples": [
        {
          "de": "Ich möchte einen großen Salat.",
          "en": "I would like a large salad."
        },
        {
          "de": "Das ist ein leckeres Abendessen.",
          "en": "That is a tasty dinner."
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "Zusammengesetzte Nomen; Nomen aus Infinitiv/Adjektiv",
      "titleEn": "Compound nouns; nouns from verbs/adjectives",
      "explanationEn": "Compounds take the gender of the last noun: der Obstsalat, das Mittagessen. Infinitives can be neuter nouns: das Essen, das Trinken. After etwas/nichts: etwas Gutes, nichts Neues.",
      "patterns": [
        "Letztes Nomen → Artikel",
        "etwas + adjective noun"
      ],
      "examples": [
        {
          "de": "Das Mittagessen ist fertig.",
          "en": "Lunch is ready."
        },
        {
          "de": "Möchten Sie etwas Vegetarisches?",
          "en": "Would you like something vegetarian?"
        }
      ]
    }
  ],
