  "grammar": [
    {
      "id": "g1",
      "titleDe": "Passiv Präsens und Präteritum",
      "titleEn": "Passive present and past",
      "explanationEn": "werden + Partizip II: Die Bewerbung wird gelesen. Die Stelle wurde besetzt. Agent with von: von der Chefin.",
      "patterns": [
        "wird gemacht",
        "wurde gemacht",
        "von + Dat."
      ],
      "examples": [
        {
          "de": "Hier wird Schokolade produziert.",
          "en": "Chocolate is produced here."
        },
        {
          "de": "Ich wurde freundlich begrüßt.",
          "en": "I was greeted kindly."
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "Wortstellung im Satz",
      "titleEn": "Word order",
      "explanationEn": "Time–manner–place tendency; verb second in main clauses; in passive the participle is at the end.",
      "patterns": [
        "Heute werde ich vorgestellt.",
        "Im Büro wird viel telefoniert."
      ],
      "examples": [
        {
          "de": "Am ersten Tag wurde ich durch die Firma geführt.",
          "en": "On the first day I was shown around the company."
        }
      ]
    }
  ],
