  "grammar": [
    {
      "id": "g1",
      "titleDe": "Wechselpräpositionen",
      "titleEn": "Two-way prepositions",
      "explanationEn": "Wo? → dative; Wohin? → accusative with in/an/auf/über/unter/vor/hinter/neben/zwischen.",
      "patterns": [
        "auf dem Tisch (Wo?)",
        "auf den Tisch (Wohin?)"
      ],
      "examples": [
        {
          "de": "Das Sofa steht neben dem Schrank.",
          "en": "The sofa is next to the wardrobe."
        },
        {
          "de": "Wir stellen die Lampe auf den Tisch.",
          "en": "We put the lamp on the table."
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "Possessivpronomen Nom./Akk./Dat.",
      "titleEn": "Possessive pronouns",
      "explanationEn": "mein/dein/unser change with gender and case: meinen Mietvertrag, meiner Wohnung, meinem Nachbarn.",
      "patterns": [
        "Nom. meine Wohnung",
        "Akk. meinen Schrank",
        "Dat. meinem Freund"
      ],
      "examples": [
        {
          "de": "Ich helfe meinem Nachbarn.",
          "en": "I help my neighbour."
        }
      ]
    }
  ],
