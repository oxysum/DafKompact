  "grammar": [
    {
      "id": "g1",
      "titleDe": "Nebensätze mit weil und dass",
      "titleEn": "weil / dass clauses",
      "explanationEn": "Verb goes to the end: Ich bleibe, weil ich studiere. Ich weiß, dass Köln schön ist.",
      "patterns": [
        "…, weil … Verb.",
        "…, dass … Verb."
      ],
      "examples": [
        {
          "de": "Ich lerne Deutsch, weil ich in Köln studiere.",
          "en": "I learn German because I study in Cologne."
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "Reflexivpronomen; Zeitpräpositionen",
      "titleEn": "Reflexives; time preps",
      "explanationEn": "sich freuen/fühlen: ich freue mich. seit + Dat., vor + Dat., nach + Dat.",
      "patterns": [
        "ich freue mich",
        "seit einem Monat",
        "vor zwei Wochen"
      ],
      "examples": [
        {
          "de": "Seit September wohne ich in einer WG.",
          "en": "I have lived in a WG since September."
        }
      ]
    }
  ],
