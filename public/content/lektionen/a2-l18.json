  "grammar": [
    {
      "id": "g1",
      "titleDe": "Komparativ und Superlativ",
      "titleEn": "Comparative and superlative",
      "explanationEn": "größer als, so groß wie, am größten / der größte. Irregular: gut→besser→am besten; gern→lieber→am liebsten.",
      "patterns": [
        "älter als",
        "so alt wie",
        "am ältesten"
      ],
      "examples": [
        {
          "de": "Der See ist schöner als das Meer.",
          "en": "The lake is nicer than the sea."
        },
        {
          "de": "Am liebsten wandere ich in den Alpen.",
          "en": "I most like hiking in the Alps."
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "wenn/als; werden + Adj./Nomen",
      "titleEn": "wenn/als; werden",
      "explanationEn": "wenn = whenever/future; als = one past time. werden: Es wird warm. Er wird Lehrer.",
      "patterns": [
        "Wenn ich Urlaub habe…",
        "Als ich am See war…",
        "Es wird schön."
      ],
      "examples": [
        {
          "de": "Wenn es regnet, bleiben wir im Gasthof.",
          "en": "When it rains we stay at the guesthouse."
        }
      ]
    }
  ],
