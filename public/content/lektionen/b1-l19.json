  "grammar": [
    {
      "id": "g1",
      "titleDe": "Höflicher Konjunktiv II von sein; Ratschläge",
      "titleEn": "Polite wäre; advice",
      "explanationEn": "wäre, hätte, könnte for soft advice: Das wäre gut. An Ihrer Stelle würde ich den Zug nehmen. Es wäre besser, früh anzukommen.",
      "patterns": [
        "Das wäre schön.",
        "Könnten Sie…?",
        "Sie sollten…"
      ],
      "examples": [
        {
          "de": "Es wäre besser, das Gepäck zu versichern.",
          "en": "It would be better to insure the luggage."
        },
        {
          "de": "Wären Sie so freundlich, mir zu helfen?",
          "en": "Would you be so kind as to help me?"
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "Attributiver Komparativ/Superlativ; Relativsatz mit wo",
      "titleEn": "Attributive comparison; wo-clauses",
      "explanationEn": "ein schnellerer Zug, die beste Verbindung. Places: die Stadt, wo ich wohne; das Land, in dem… / wo…",
      "patterns": [
        "ein größerer Koffer",
        "die Stadt, wo…"
      ],
      "examples": [
        {
          "de": "Vaduz ist die Stadt, wo ich arbeite.",
          "en": "Vaduz is the city where I work."
        },
        {
          "de": "Wir brauchen eine schnellere Verbindung.",
          "en": "We need a faster connection."
        }
      ]
    }
