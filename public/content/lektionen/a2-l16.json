  "grammar": [
    {
      "id": "g1",
      "titleDe": "Höflicher Konjunktiv II",
      "titleEn": "Polite subjunctive II",
      "explanationEn": "hätte, könnte, dürfte, sollte, würde + Inf. for polite wishes/advice: Könnten Sie mir helfen? Du solltest Medizin studieren.",
      "patterns": [
        "Könnten Sie…?",
        "Ich würde…",
        "Sie sollten…"
      ],
      "examples": [
        {
          "de": "Könnten Sie mich beraten?",
          "en": "Could you advise me?"
        },
        {
          "de": "An Ihrer Stelle würde ich ein Praktikum machen.",
          "en": "In your place I would do an internship."
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "Genitiv und Relativsätze",
      "titleEn": "Genitive & relative clauses",
      "explanationEn": "Genitive: das Büro des Lehrers, die Idee einer Freundin. Relative: Der Beruf, der mir gefällt…; Die Firma, in der ich arbeite…",
      "patterns": [
        "des Mannes / der Frau",
        "der Mann, der…",
        "die Frau, die…"
      ],
      "examples": [
        {
          "de": "Das ist der Beruf, der zu mir passt.",
          "en": "That is the job that suits me."
        }
      ]
    }
  ],
