  "grammar": [
    {
      "id": "g1",
      "titleDe": "Dativ: Personalpronomen und Verben mit Dativ",
      "titleEn": "Dative: pronouns and verbs that take the dative",
      "explanationEn": "The dative answers wem? (to/for whom?). Pronouns: mir, dir, ihm, ihr, uns, euch, ihnen/Ihnen. Common verbs: helfen, danken, gratulieren, schenken, geben, gehören. Often: Ich schenke dir ein Buch. (dative person + accusative thing).",
      "patterns": [
        "Wem? → mir / dir / ihm / ihr / uns / euch / ihnen",
        "Ich helfe dir.",
        "Ich schenke ihr ein Geschenk."
      ],
      "examples": [
        {
          "de": "Wem schenken wir das Buch?",
          "en": "Who are we giving the book to?"
        },
        {
          "de": "Ich danke Ihnen für die Einladung.",
          "en": "I thank you for the invitation."
        },
        {
          "de": "Wir gratulieren ihm zum Geburtstag.",
          "en": "We congratulate him on his birthday."
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "n-Deklination und Artikel im Dativ",
      "titleEn": "n-declension and dative articles",
      "explanationEn": "Masculine weak nouns (der Student, der Herr, der Name…) add -n/-en in Accusative and Dative singular: dem Studenten, den Herrn. Dative articles: dem / der / dem / den (plural). Possessives follow the same pattern: meinem Freund, meiner Freundin.",
      "patterns": [
        "dem Studenten / dem Herrn",
        "der Frau (Dat. fem.)",
        "Dat. + Akk.: Ich gebe dem Gast das Geschenk."
      ],
      "examples": [
        {
          "de": "Wir laden den Studenten ein.",
          "en": "We invite the student."
        },
        {
          "de": "Ich helfe dem Herrn.",
          "en": "I help the gentleman."
        },
        {
          "de": "Das Geschenk gehört der Freundin.",
          "en": "The gift belongs to the (female) friend."
        }
      ]
    }
  ],
