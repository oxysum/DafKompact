      "id": "d4",
      "type": "cloze",
      "promptDe": "n-Deklination im Dativ.",
      "promptEn": "n-declension in the dative.",
      "content": "Ich helfe dem ___. (Student)",
      "answer": "Studenten",
      "grammarId": "g2"
    },
    {
      "id": "d5",
      "type": "reorder",
      "promptDe": "Bringe die Wörter in die richtige Reihenfolge.",
      "promptEn": "Put the words in the correct order.",
      "content": "Ich | schenke | dir | ein | Geschenk | .",
      "answer": "Ich schenke dir ein Geschenk.",
      "grammarId": "g1"
    },
    {
