        "du",
        "dein"
      ],
      "answer": "dir",
      "grammarId": "g1"
    },
    {
      "id": "d2",
      "type": "cloze",
      "promptDe": "Ergänze das Dativpronomen.",
      "promptEn": "Fill in the dative pronoun.",
      "content": "Wir schenken ___ ein Buch. (sie – singular feminine)",
