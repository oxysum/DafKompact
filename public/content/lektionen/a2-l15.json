  "grammar": [
    {
      "id": "g1",
      "titleDe": "welcher/dieser/jeder; indirekte Fragesätze",
      "titleEn": "which/this/every; indirect questions",
      "explanationEn": "welcher/dieses… agree with the noun. Indirect questions: Ich möchte wissen, wo der Bahnhof ist. (verb at end)",
      "patterns": [
        "Welches Hotel?",
        "Ich frage, wann der Zug kommt."
      ],
      "examples": [
        {
          "de": "Können Sie mir sagen, wie ich zum Schloss komme?",
          "en": "Can you tell me how I get to the palace?"
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "Ortsangaben: bei, zu, entlang, gegenüber…",
      "titleEn": "Place expressions",
      "explanationEn": "bei + Dat., zu/zum/zur, gegenüber von, entlang (often after noun), rein/raus with motion.",
      "patterns": [
        "beim Hotel",
        "zum Bahnhof",
        "die Straße entlang"
      ],
      "examples": [
        {
          "de": "Das Café liegt gegenüber vom Museum.",
          "en": "The café is opposite the museum."
        }
      ]
    }
