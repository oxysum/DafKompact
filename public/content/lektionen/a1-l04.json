  "grammar": [
    {
      "id": "g1",
      "titleDe": "Modalverben dürfen, wollen, mögen; Verben mit Vokalwechsel",
      "titleEn": "Modals dürfen/wollen/mögen; stem-vowel change verbs",
      "explanationEn": "dürfen = be allowed; wollen = want; mögen = like. Some verbs change vowel in du/er: ich lese, du liest, er liest; ich laufe, du läufst.",
      "patterns": [
        "ich darf / will / mag",
        "du liest / läufst / sprichst"
      ],
      "examples": [
        {
          "de": "Darf ich mitspielen?",
          "en": "May I join in?"
        },
        {
          "de": "Ich will Tennis spielen.",
          "en": "I want to play tennis."
        },
        {
          "de": "Er liest gern.",
          "en": "He likes to read."
        }
      ],
      "titleFa": "افعال وجهی dürfen/wollen/mögen؛ فعل‌های با تغییر واکه",
      "explanationFa": "dürfen = اجازه داشتن؛ wollen = خواستن؛ mögen = دوست داشتن. برخی فعل‌ها در du/er واکه عوض می‌کنند: ich lese، du liest؛ ich fahre، du fährst."
    },
    {
      "id": "g2",
      "titleDe": "haben/sein im Präteritum; Konnektoren denn, oder, aber",
      "titleEn": "haben/sein simple past; connectors denn/oder/aber",
      "explanationEn": "ich war, du warst, er war; ich hatte, du hattest. denn/oder/aber join main clauses; verb stays in position 2 in each clause.",
      "patterns": [
        "Ich war müde.",
        "Ich hatte keine Zeit.",
        "…, denn … / …, aber …"
      ],
      "examples": [
        {
          "de": "Gestern war ich im Verein.",
          "en": "Yesterday I was at the club."
        },
        {
          "de": "Ich mag Fußball, aber nicht Tennis.",
          "en": "I like football, but not tennis."
        }
      ],
      "titleFa": "haben/sein در گذشته ساده؛ حروف ربط denn/oder/aber",
      "explanationFa": "ich war، du warst؛ ich hatte، du hattest. denn/oder/aber جمله‌های اصلی را وصل می‌کنند و فعل در هر بند در جایگاه ۲ می‌ماند."
    }
  ],
