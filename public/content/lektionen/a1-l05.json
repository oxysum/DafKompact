  "grammar": [
    {
      "id": "g1",
      "titleDe": "Trennbare Verben im Präsens und Perfekt",
      "titleEn": "Separable verbs in present and perfect",
      "explanationEn": "Prefix goes to the end in present: Ich räume das Zimmer auf. In perfect: Ich habe das Zimmer aufgeräumt. With modals: Ich will aufräumen (prefix stays with infinitive).",
      "patterns": [
        "Ich stehe um sieben auf.",
        "Ich habe aufgeräumt.",
        "Ich möchte einkaufen."
      ],
      "examples": [
        {
          "de": "Wann ziehst du ein?",
          "en": "When do you move in?"
        },
        {
          "de": "Ich habe ein Bett mitgebracht.",
          "en": "I brought a bed along."
        }
      ],
      "titleFa": "فعل‌های جداشدنی در حال و کامل",
      "explanationFa": "در حال، پیشوند به پایان می‌رود: Ich räume das Zimmer auf. در کامل: Ich habe das Zimmer aufgeräumt."
    },
    {
      "id": "g2",
      "titleDe": "Regelmäßige Verben im Perfekt",
      "titleEn": "Regular verbs in the perfect",
      "explanationEn": "Most verbs use haben + ge-…-t: ich habe gesucht, gekauft, gemacht. Movement/change often use sein: ich bin eingezogen.",
      "patterns": [
        "haben + Partizip II",
        "sein + Partizip II (Bewegung)"
      ],
      "examples": [
        {
          "de": "Ich habe ein Zimmer gefunden.",
          "en": "I have found a room."
        },
        {
          "de": "Sie ist gestern eingezogen.",
          "en": "She moved in yesterday."
        }
      ],
      "titleFa": "فعل‌های باقاعده در زمان کامل (Perfekt)",
      "explanationFa": "بیشتر فعل‌ها با haben + ge-…-t می‌آیند: ich habe gesucht. حرکت/تغییر وضعیت اغلب با sein: ich bin eingezogen."
    }
  ],
