  "grammar": [
    {
      "id": "g1",
      "titleDe": "Präteritum (Erzähltempus)",
      "titleEn": "Simple past for storytelling",
      "explanationEn": "Use Präteritum for written/narrative past: ich war, hatte, ging, kam, sagte; modals: konnte, wollte, musste.",
      "patterns": [
        "ich ging / er kam / wir hatten",
        "ich konnte / wollte / musste"
      ],
      "examples": [
        {
          "de": "Gestern ging ich zur Bank.",
          "en": "Yesterday I went to the bank."
        },
        {
          "de": "Er konnte die PIN nicht finden.",
          "en": "He could not find the PIN."
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "Nebensätze mit als und wenn",
      "titleEn": "als vs wenn",
      "explanationEn": "als = one-time past event; wenn = whenever/habitual or future if. Als ich ankam, war die Bank zu. Wenn ich Geld brauche, gehe ich zur Bank.",
      "patterns": [
        "als + past one-time",
        "wenn = whenever / if"
      ],
      "examples": [
        {
          "de": "Als ich das Märchen hörte, musste ich lachen.",
          "en": "When I heard the fairy tale, I had to laugh."
        }
      ]
    }
  ],
