  "grammar": [
    {
      "id": "g1",
      "titleDe": "Imperativ (Sie / du / ihr) und Vorschläge",
      "titleEn": "Imperative and suggestions",
      "explanationEn": "Formal: Nehmen Sie …! Informal du: Nimm …! ihr: Nehmt …! Suggestions: Sollen/Wollen wir …? Soll ich …?",
      "patterns": [
        "Lesen Sie die Anleitung!",
        "Wasch die Hose!",
        "Sollen wir waschen gehen?"
      ],
      "examples": [
        {
          "de": "Probieren Sie die Jacke an!",
          "en": "Try on the jacket!"
        },
        {
          "de": "Wollen wir neue Schuhe kaufen?",
          "en": "Shall we buy new shoes?"
        }
      ],
      "titleFa": "امر و پیشنهادها",
      "explanationFa": "رسمی: Nehmen Sie …! غیررسمی du: Nimm …! جمع ihr: Nehmt …! پیشنهاد: Sollen/Wollen wir …؟"
    },
    {
      "id": "g2",
      "titleDe": "Unregelmäßige und gemischte Verben im Perfekt; untrennbare Vorsilben",
      "titleEn": "Irregular/mixed perfect; inseparable prefixes",
      "explanationEn": "Irregular: gefunden, genommen, gewaschen. Mixed: gebracht, gedacht. Inseparable be-/ge-/er-/ver-/zer- have no extra ge-: Ich habe die Hose gewaschen; Ich habe die Farbe empfohlen.",
      "patterns": [
        "haben + irregular participle",
        "ver-/be- without ge-"
      ],
      "examples": [
        {
          "de": "Ich habe meine Jacke gewaschen.",
          "en": "I washed my jacket."
        },
        {
          "de": "Er hat einen Pullover gefunden.",
          "en": "He found a sweater."
        }
      ],
      "titleFa": "فعل‌های بی‌قاعده و ترکیبی در کامل؛ پیشوندهای جدا‌نشدنی",
      "explanationFa": "بی‌قاعده: gefunden، genommen. ترکیبی: gebracht، gedacht. پیشوندهای be-/ge-/er-/ver-/zer- بدون ge- اضافی: besucht، verkauft."
    }
  ],
