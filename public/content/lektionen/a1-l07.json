  "grammar": [
    {
      "id": "g1",
      "titleDe": "Ortsangaben mit Akkusativ und Dativ",
      "titleEn": "Place phrases with accusative and dative",
      "explanationEn": "Two-way prepositions (in, an, auf, neben…): location (where?) → dative; direction (where to?) → accusative. Ich bin in der Stadt. Ich gehe in die Stadt.",
      "patterns": [
        "Wo? → Dativ",
        "Wohin? → Akkusativ"
      ],
      "examples": [
        {
          "de": "Das Museum ist neben dem Bahnhof.",
          "en": "The museum is next to the station."
        },
        {
          "de": "Wir gehen auf den Platz.",
          "en": "We go onto the square."
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "Indefinitpronomen etwas/nichts/alle/man; Präsens für Zukunft",
      "titleEn": "Indefinite pronouns; present for future",
      "explanationEn": "man sagt… = people say. etwas/nichts. Present can mean future with a time word: Morgen fahren wir nach Bern.",
      "patterns": [
        "Man nimmt die Straßenbahn.",
        "Morgen besuche ich das Museum."
      ],
      "examples": [
        {
          "de": "Hier findet man nichts Interessantes.",
          "en": "You find nothing interesting here."
        },
        {
          "de": "Nächste Woche fahren wir in die Schweiz.",
          "en": "Next week we are going to Switzerland."
        }
      ]
    }
  ],
