  "grammar": [
    {
      "id": "g1",
      "titleDe": "seit(dem) und bis; Modalverben-Bedeutung",
      "titleEn": "seit/bis; modal meanings",
      "explanationEn": "seit(dem) = since/for; bis = until. Modals: müssen (obligation), sollen (advice), dürfen (permission), können (ability), wollen (want). brauchen nicht zu + Inf.",
      "patterns": [
        "seit gestern",
        "bis Montag",
        "Du brauchst nicht zu kommen."
      ],
      "examples": [
        {
          "de": "Seit einer Woche ist es kalt.",
          "en": "It has been cold for a week."
        },
        {
          "de": "Du brauchst keinen Schirm mitzunehmen.",
          "en": "You need not take an umbrella."
        }
      ]
    },
    {
      "id": "g2",
      "titleDe": "darum/deshalb/deswegen; Diminutiv",
      "titleEn": "Causal adverbs; diminutives",
      "explanationEn": "Causal linking adverbs start the next main clause (verb still position 2): Es regnet, deshalb bleibe ich zu Hause. Diminutive -chen/-lein → das: das Bierchen.",
      "patterns": [
        "…, deshalb … Verb.",
        "das Festchen"
      ],
      "examples": [
        {
          "de": "Es ist kalt, darum trage ich einen Schal.",
          "en": "It is cold, that is why I wear a scarf."
        }
      ]
    }
  ],
